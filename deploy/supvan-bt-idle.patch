+fn disconnect_bluez(addr: &str) {
+    use dbus::blocking::stdintf::org_freedesktop_dbus::ObjectManager;
+    let result = (|| -> Result<(), dbus::Error> {
+        let connection = dbus::blocking::Connection::new_system()?;
+        let timeout = Duration::from_secs(5);
+        let objects = connection
+            .with_proxy("org.bluez", "/", timeout)
+            .get_managed_objects()?;
+        for (path, interfaces) in objects {
+            if interfaces
+                .get("org.bluez.Device1")
+                .and_then(|props| props.get("Address"))
+                .and_then(|value| value.0.as_str())
+                == Some(addr)
+            {
+                return connection
+                    .with_proxy("org.bluez", path, timeout)
+                    .method_call("org.bluez.Device1", "Disconnect", ());
+            }
+        }
+        Ok(())
+    })();
+    if let Err(error) = result {
+        log::warn!("Bluetooth disconnect for {addr}: {error}");
+    }
+}
+
+pub async fn reap_idle_connections() {
+    loop {
+        tokio::time::sleep(Duration::from_secs(1)).await;
+        if let Some(timeout) = bt_idle_timeout() {
+            let _gate = bt_connection_gate().lock().await;
+            let expired = {
+                let mut cache = bt_cache().lock().unwrap();
+                let expired: Vec<String> = cache
+                    .iter()
+                    .filter(|(_, entry)| {
+                        Arc::strong_count(&entry.printer) == 1
+                            && entry.last_activity.elapsed() >= timeout
+                    })
+                    .map(|(addr, _)| addr.clone())
+                    .collect();
+                for addr in &expired {
+                    cache.remove(addr);
+                }
+                expired
+            };
+            for addr in expired {
+                log::info!("Bluetooth idle timeout: disconnecting {addr}");
+                let _ = tokio::task::spawn_blocking(move || disconnect_bluez(&addr)).await;
+            }
+        }
+    }
+}
+
+pub fn idle_bluetooth_poll(uri: &str) -> bool {
+    if bt_idle_timeout().is_none() {
