+    }
+    let Some(slug) = uri.strip_prefix("supvan://") else {
+        return false;
+    };
+    let entry = supvan_map().lock().unwrap().get(slug).cloned();
+    let Some(entry) = entry else {
+        return false;
+    };
+    if entry
+        .hidraw_path
+        .as_ref()
+        .is_some_and(|path| std::path::Path::new(path).exists())
+    {
+        return false;
+    }
+    entry.bt_address.is_some()
+}
